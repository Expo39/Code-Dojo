{
  "promptSuggestionEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && (python3 dojo.py brief 2>/dev/null || python dojo.py brief)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 dojo.py *)",
      "Bash(python dojo.py *)",
      "Bash(py dojo.py *)"
    ],
    "ask": [
      "Edit(/workspace/python/**)",
      "Write(/workspace/python/**)",
      "Edit(/workspace/projects/**)",
      "Write(/workspace/projects/**)",
      "Bash(git push*)",
      "Bash(python3 dojo.py update*)",
      "Bash(python dojo.py update*)",
      "Bash(py dojo.py update*)"
    ],
    "deny": [
      "Read(/.gemini/**)",
      "Read(/.geminiignore)",
      "Read(/.codex/**)"
    ]
  }
}
