{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: current exercise's tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dojo.py",
      "args": [
        "test",
        "${fileBasenameNoExtension}",
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
