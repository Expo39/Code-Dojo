{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: this file (exercise, drill, mock, lesson)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dojo.py",
      "args": [
        "debug",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: current file as a script",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
